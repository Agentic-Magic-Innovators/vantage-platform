# Shared secrets — copy to .env and change before production
TELEMETRY_INTERNAL_KEY=dev-internal-key-change-me
TELEMETRY_BRIDGE_JWT_SECRET=dev-bridge-secret-change-me

POSTGRES_USER=vantage
POSTGRES_PASSWORD=vantage
POSTGRES_DB=vantage
POSTGRES_PORT=5433

VANTAGE_HARNESS_PORT=50223
VANTAGE_TELEMETRY_PORT=50224
VANTAGE_HARNESS_UI_PORT=50225
VANTAGE_TELEMETRY_UI_PORT=50226

OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
VANTAGE_API_KEY=
VANTAGE_ADMIN_TOKEN=

CORS_ORIGINS=http://localhost:50223,http://localhost:50225

# Bootstrap admin (required once — new split DB does not inherit old monolith admins)
VANTAGE_ADMIN_USERNAME=admin
VANTAGE_ADMIN_PASSWORD=change-me
